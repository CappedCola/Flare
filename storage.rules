rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos uploaded by users - readable by all authenticated users for global feed
    match /photos/{userId}/{filename} {
      // Allow authenticated users to read all photos (for global feed)
      allow read: if request.auth != null;
      
      // Only allow the photo owner to upload/update/delete their photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User avatars/profile pictures
    match /avatars/{userId}/{filename} {
      // Allow authenticated users to read all avatars
      allow read: if request.auth != null;
      
      // Only allow users to upload their own avatar
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Personal photos for direct sharing/messaging
    match /personal_photos/{userId}/{filename} {
      // Allow authenticated users to read personal photos
      allow read: if request.auth != null;
      
      // Only allow the photo owner to upload/update/delete their personal photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Thumbnails and processed images
    match /thumbnails/{userId}/{filename} {
      // Allow authenticated users to read all thumbnails
      allow read: if request.auth != null;
      
      // Only allow the owner to write thumbnails (usually done by Cloud Functions)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Flare Chain photos
    match /chains/{chainId}/{filename} {
      // Allow authenticated users to read chain photos
      allow read: if request.auth != null;
      
      // Allow authenticated users to upload chain photos (participants in the chain)
      allow write: if request.auth != null;
    }
    
    // Deny access to all other files
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}