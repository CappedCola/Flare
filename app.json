{
  "expo": {
    "name": "Flare",
    "slug": "flare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "53.0.0",
    "icon": "./app/assets/images/icon.png",
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera"
          ]
        }
      ]
    ],
    "splash": {
      "image": "./app/assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6EC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./app/assets/images/icon.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "com.cappedcola.flare",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Flare needs camera access to capture photos for your daily streaks."
      }
    },
    "android": {
      "icon": "./app/assets/images/icon.png",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/images/adaptive-icon.png",
        "backgroundColor": "#FDF6EC"
      }
    },
    "owner": "cappedcola",
    "extra": {
      "eas": {
        "projectId": "b258bf68-5821-453e-9989-f096b38a4802"
      }
    }
  }
}
