rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own user document and create/update it when authenticated
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reading other users' basic info for posts (username, avatar)
      allow read: if request.auth != null;
    }
    
    // Posts collection - Global feed functionality
    match /posts/{postId} {
      // Anyone authenticated can read all posts (global feed)
      allow read: if request.auth != null;
      
      // Only the post author can create posts under their userId
      allow create: if request.auth != null && 
                   request.auth.uid == request.resource.data.userId;
      
      // Post authors can update/delete all fields of their posts
      allow update, delete: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
      
      // Any authenticated user can update ONLY the likes array or comments array for social interactions
      allow update: if request.auth != null && 
                   (isOnlyUpdatingLikes(request.resource.data, resource.data) ||
                    isOnlyUpdatingComments(request.resource.data, resource.data));
    }
    
    // Helper function to check if only likes array is being updated
    function isOnlyUpdatingLikes(newData, oldData) {
      // Check that only 'likes' field is different and all other critical fields remain unchanged
      return newData.diff(oldData).affectedKeys().hasOnly(['likes']) &&
             newData.userId == oldData.userId &&
             newData.photoUrl == oldData.photoUrl &&
             newData.caption == oldData.caption &&
             newData.username == oldData.username;
    }
    
    // Helper function to check if only comments array is being updated
    function isOnlyUpdatingComments(newData, oldData) {
      // Check that only 'comments' field is different and all other critical fields remain unchanged
      return newData.diff(oldData).affectedKeys().hasOnly(['comments']) &&
             newData.userId == oldData.userId &&
             newData.photoUrl == oldData.photoUrl &&
             newData.caption == oldData.caption &&
             newData.username == oldData.username;
    }
    
    // Streaks collection - User-specific
    match /streaks/{streakId} {
      allow read, write: if request.auth != null && 
                        request.auth.uid == resource.data.userId;
    }
    
    // Comments subcollection (if implemented later)
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
      allow update, delete: if request.auth != null && 
                           request.auth.uid == resource.data.userId;
    }
    
    // Friend requests collection
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null && 
                        (request.auth.uid == resource.data.fromUserId || 
                         request.auth.uid == resource.data.toUserId);
      // Allow creating friend requests
      allow create: if request.auth != null && 
                   request.auth.uid == request.resource.data.fromUserId;
    }
    
    // Personal posts collection (for targeted photo sharing)
    match /personal_posts/{postId} {
      // Allow all authenticated users to read personal posts
      // (filtering will be handled at the application level)
      allow read, write: if request.auth != null;
    }
    
    // User statistics for achievements and leaderboards
    match /userStatistics/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reading others' stats for leaderboards
      allow read: if request.auth != null;
    }
    
    // Achievement notifications
    match /achievementNotifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Custom prompts (community-created)
    match /customPrompts/{promptId} {
      // All users can read approved prompts
      allow read: if request.auth != null;
      // Users can create prompts
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      // Users can update their own prompts
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // Prompt ratings
    match /promptRatings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // User prompt history (favorites, usage tracking)
    match /userPromptHistory/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Competition events
    match /competitions/{competitionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
    
    // Flare Chains collection - Photo passing game chains
    match /flareChains/{chainId} {
      // Allow reading chains where user is a participant (using participantIds array)
      allow read: if request.auth != null && 
                  (request.auth.uid in resource.data.participantIds ||
                   request.auth.uid == resource.data.creatorId);
      
      // Allow creating chains where user is the creator
      allow create: if request.auth != null && 
                   request.auth.uid == request.resource.data.creatorId;
      
      // Allow updating chains where user is a participant or creator
      // (for adding photos, updating status, etc.)
      allow update: if request.auth != null && 
                   (request.auth.uid in resource.data.participantIds ||
                    request.auth.uid == resource.data.creatorId);
      
      // Only creator can delete chains
      allow delete: if request.auth != null && 
                   request.auth.uid == resource.data.creatorId;
    }
    
    // Deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}