# Flare App Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit the actual .env file to version control

# Expo Configuration
EXPO_PUBLIC_API_URL=https://your-api-url.com
EXPO_PUBLIC_APP_ENV=development

# Firebase Configuration (if using environment variables)
# Note: Most Firebase config should be in google-services.json and GoogleService-Info.plist
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789

# Third-party API Keys (examples)
SOME_API_KEY=your_api_key_here
ANALYTICS_KEY=your_analytics_key_here

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=debug